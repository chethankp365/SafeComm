# SafeComm Supabase Configuration
# Retrieve these from your Supabase Dashboard: Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Groq is used server-side for instruction extraction; deterministic logic decides the verdict.
GROQ_API_KEY=your-groq-api-key
# Optional; defaults to openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-20b
